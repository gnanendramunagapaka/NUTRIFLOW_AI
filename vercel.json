{
  "buildCommand": "pnpm --filter @workspace/nutriflow run build",
  "outputDirectory": "artifacts/nutriflow/dist/public",
  "installCommand": "pnpm install",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{artifacts/api-server/**,lib/**}"
    }
  },
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }
  ]
}
